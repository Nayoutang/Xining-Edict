{
  "name": "xining-edict",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "electron:dir": "npm run build && electron-builder --win dir --publish never",
    "electron:pack": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "cn.xining.juezhe",
    "productName": "熙宁抉择",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "server.mjs",
      "ai-history.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "server.mjs",
      "ai-history.mjs"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      }
    ],
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico",
      "artifactName": "Xining-Edict-Windows.exe",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Xining-Edict-Windows.exe"
    }
  }
}
